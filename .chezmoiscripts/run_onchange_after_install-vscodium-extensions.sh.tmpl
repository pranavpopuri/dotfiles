#!/bin/bash
set -e

# VSCodium extensions. This is a run_onchange_ script, so chezmoi re-runs it
# whenever the list below changes. Regenerate with: codium --list-extensions

if ! command -v codium >/dev/null 2>&1; then
	echo "codium not found, skipping VSCodium extension install" >&2
	exit 0
fi

extensions=(
	3timeslazy.vscodium-devpodcontainers
	jasew.vscode-helix-emulation
	jeanp413.open-remote-ssh
	kdarkhan.mips
	llvm-vs-code-extensions.vscode-clangd
	ms-python.debugpy
	ms-python.python
	ms-python.vscode-python-envs
	navernoedenis.gruvbox-material-theme
	rust-lang.rust-analyzer
)

for extension in "${extensions[@]}"; do
	codium --install-extension "$extension"
done
