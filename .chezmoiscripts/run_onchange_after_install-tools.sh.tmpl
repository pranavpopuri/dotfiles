#!/bin/bash
set -e

# Re-run automatically when the package lists change:
# Brewfile.core:    {{ include "Brewfile.core" | sha256sum }}
# linux installer:  {{ include "install-tools-linux.sh" | sha256sum }}

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null 2>&1; then
	echo "Installing Homebrew..."
	NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/main/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"
brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile.core"
{{ else if eq .chezmoi.os "linux" -}}
bash "{{ .chezmoi.sourceDir }}/install-tools-linux.sh"
{{ end -}}

# wikimap toolchain: markmap renders map.md into an interactive tree,
# markserv serves the wiki so map nodes open rendered markdown.
if command -v npm >/dev/null 2>&1; then
	for pkg in markmap-cli markserv; do
		npm ls -g --depth=0 "$pkg" >/dev/null 2>&1 || npm install -g "$pkg"
	done
fi
