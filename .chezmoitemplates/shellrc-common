export PATH="$HOME/bin:$PATH"

command -v tirith >/dev/null && eval "$(tirith init)"
command -v thefuck >/dev/null && eval "$(thefuck --alias)"

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

command -v eza >/dev/null && alias ls="eza --icons"
# Wrap glow to the terminal width, leaving a small margin for clean wrapping
unalias glow 2>/dev/null
glow() { command glow --width "$(( $(tput cols) - 2 ))" "$@"; }
alias claude="claude --dangerously-skip-permissions"
alias wc-open="cd ~/Documents/wiki/goals+schedules+habits/daily && sc-im week-calendar-summer-2026.sc"
