export PATH="$HOME/bin:$PATH"

command -v thefuck >/dev/null && eval "$(thefuck --alias)"

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

# eza colors use ANSI palette slots so they follow the active Ghostty theme.
# di=dir(blue) ex=exec(green) ln=symlink(magenta) or=broken link(red)
# media=yellow  metadata=bright black
export EZA_COLORS="di=1;34:ex=1;32:ln=35:or=31:\
*.png=33:*.jpg=33:*.jpeg=33:*.gif=33:*.svg=33:*.webp=33:\
*.mp4=33:*.mov=33:*.mp3=33:*.wav=33:\
xx=90:da=90:uu=90:sb=90"
command -v eza >/dev/null && alias ls="eza --icons"


# Wrap glow to the terminal width, leaving a small margin for clean wrapping
unalias glow 2>/dev/null
glow() { command glow --width "$(( $(tput cols) - 2 ))" "$@"; }
# Fuzzy-find a file and open it: hxf -> Helix, gwf -> glow. Esc cancels cleanly.
hxf() { local f; f="$(fzf --preview 'cat -- {}' --query "$*")" && [ -n "$f" ] && hx -- "$f"; }
gwf() { local f; f="$(fzf --preview 'cat -- {}' --query "$*")" && [ -n "$f" ] && glow -- "$f"; }

alias claude="claude --dangerously-skip-permissions"
alias wc-open="cd ~/Documents/wiki/goals+schedules+habits/daily && sc-im week-calendar-fall-2026.sc"
