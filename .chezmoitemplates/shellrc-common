export PATH="$HOME/bin:$PATH"

command -v tirith >/dev/null && eval "$(tirith init)"
command -v thefuck >/dev/null && eval "$(thefuck --alias)"

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

