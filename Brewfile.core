brew "chezmoi"
brew "helix"
brew "yazi"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "eza"
brew "zoxide"
brew "glow"
# node: powers the markmap/markserv wiki-map toolchain (see wikimap)
brew "node"
cask "font-fira-code-nerd-font"
# Prompt engine behind ~/.config/starship.toml (referenced by .zshrc)
brew "starship"
# Node version manager, auto-switches per .nvmrc (referenced by .zshrc)
brew "fnm"
# Shell prompt assistant (referenced by the shared shellrc)
tap "sheeki03/tap", trusted: true
brew "sheeki03/tap/tirith", trusted: true
# AI coding agent, exposed as `oc` in zsh
tap "anomalyco/tap", trusted: true
brew "anomalyco/tap/opencode-v2", trusted: true
