# Ghostty Configuration

# Font
font-family = "Menlo"
font-size = 14
font-feature = +liga
font-feature = +calt
adjust-cell-height = 30%

# Window
macos-titlebar-style = transparent
window-save-state = always
window-theme = ghostty
window-padding-x = 8
window-padding-y = 8

# Cursor
cursor-style = block
cursor-style-blink = true

# Colors — Gruvbox Material Dark matches the Helix theme.
# Background overridden to #1F1F1F (darker than the theme's #282828).
theme = Gruvbox Material Dark
background = 1f1f1f
