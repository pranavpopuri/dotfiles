# Evaluate on the closing cas; math auto-expansions are suppressed while typing CAS input.
global
function evaluateCAS(expression, workspace, original) {
    const fs = require('fs');
    const pathModule = require('path');
    const root = process.env.LATEX_WORKFLOW_HOME || pathModule.join(require('os').homedir(), '.local', 'share', 'latex-workflow');
    const python = pathModule.join(root, '.venv', 'bin', 'python');
    const helper = pathModule.join(root, 'tools', 'cas.py');
    try {
        if (!root || !fs.existsSync(python)) throw new Error('Run latex-workflow setup in a terminal first.');
        return require('child_process').execFileSync(python, [helper], {
            input: expression, encoding: 'utf8', timeout: 5000,
            maxBuffer: 1024 * 1024, stdio: ['pipe', 'pipe', 'pipe']
        }).trim();
    } catch (error) {
        const detail = error.stderr ? String(error.stderr).trim() : error.message;
        require('vscode').window.showErrorMessage('SymPy: ' + detail);
        return original;
    }
}
endglobal

priority 1000
snippet `\bcas (.+?) cas` "Evaluate SymPy expression as LaTeX" A
``rv = evaluateCAS(m[1], w, m[0]);``
endsnippet
