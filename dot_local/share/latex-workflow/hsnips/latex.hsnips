# VS Code HyperSnips math snippets — corrected template and math-only auto-expansion.
# The == shortcut intentionally uses Tab (not auto) because &= is only legal in alignments.
# Required by the original figure macros: import, xifthen, pdfpages, transparent.
# Optional extras: pgfplots for plot; siunitx for fully featured SI units.

global
function math(context) {
    const editor = require('vscode').window.activeTextEditor;
    if (editor) {
        const position = editor.selection.active;
        const prefix = editor.document.lineAt(position.line).text.slice(0, position.character + 1);
        if (/(?:^|[^A-Za-z])cas /.test(prefix)) return false;
    }
	return context.scopes.some(s => s.startsWith("meta.math"));
}

function parenFrac(line) {
	var s = line.slice(0, -1);
	var depth = 0;
	var i = s.length - 1;
	for (; i >= 0; i--) {
		if (s[i] === ')') depth++;
		if (s[i] === '(') depth--;
		if (depth === 0) break;
	}
	if (i < 0) return line;
	return s.slice(0, i) + '\\frac{' + s.slice(i + 1, -1) + '}';
}
endglobal


snippet template "Basic template (VS Code / TinyTeX safe)" b
\documentclass[a4paper]{article}

\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{textcomp}
\usepackage{amsmath,amssymb}
\usepackage{graphicx}

% Figure support: the same packages as the original template.
\usepackage{import}
\usepackage{xifthen}
\usepackage{pdfpages}
\usepackage{transparent}
\newcommand{\incfig}[1]{%
    \def\svgwidth{\columnwidth}
    \import{./figures/}{#1.pdf_tex}
}

% Number-set shortcuts used by NN/RR/QQ/ZZ/R0+ etc.
\providecommand{\N}{\mathbb{N}}
\providecommand{\R}{\mathbb{R}}
\providecommand{\Q}{\mathbb{Q}}
\providecommand{\Z}{\mathbb{Z}}

% Load optional packages when available. Keep parameterized definitions
% OUTSIDE \IfFileExists branches to avoid "Illegal parameter number".
\IfFileExists{siunitx.sty}{\usepackage{siunitx}}{}
\providecommand{\SI}[2]{\ensuremath{#1\,\mathrm{#2}}}
\IfFileExists{pgfplots.sty}{%
    \usepackage{pgfplots}
    \pgfplotsset{compat=1.18}
}{}

\begin{document}
\section{Math Notes}

$0
\end{document}
endsnippet

