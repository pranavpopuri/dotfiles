{
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "**/.venv/**",
    "**/texmf/**",
    "**/pythontex-files-*/**"
  ],
  "words": [
    "SymPy",
    "PythonTeX",
    "TinyTeX",
    "HyperSnips",
    "VSCodium",
    "Inkscape",
    "PGFPlots",
    "integrand",
    "eigenvalue",
    "eigenvector"
  ],
  "ignoreRegExpList": [
    "/\\\\[A-Za-z@]+/g",
    "/\\$\\$[\\s\\S]*?\\$\\$/g",
    "/\\$(?:\\\\.|[^$\\\\])*\\$/g",
    "/\\\\\\[[\\s\\S]*?\\\\\\]/g",
    "/\\\\\\([\\s\\S]*?\\\\\\)/g",
    "/\\\\begin\\{(equation\\*?|align\\*?|gather\\*?|sympycode|pycode|tikzpicture)\\}[\\s\\S]*?\\\\end\\{\\1\\}/g"
  ]
}
