{
  "inputs": [
    {
      "default": "diagram",
      "description": "Figure name (letters, digits, hyphens, underscores)",
      "id": "figureName",
      "type": "promptString"
    }
  ],
  "tasks": [
    {
      "args": [
        "{{ .chezmoi.homeDir }}/.local/share/latex-workflow/tools/figure.py",
        "edit",
        "${input:figureName}",
        "--project",
        "${workspaceFolder}"
      ],
      "command": "{{ .chezmoi.homeDir }}/.local/share/latex-workflow/.venv/bin/python",
      "label": "Figure: edit/create SVG",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MPLCONFIGDIR": "{{ .chezmoi.homeDir }}/.local/share/latex-workflow/cache/matplotlib"
        }
      },
      "problemMatcher": [],
      "type": "process"
    },
    {
      "args": [
        "{{ .chezmoi.homeDir }}/.local/share/latex-workflow/tools/figure.py",
        "export",
        "${input:figureName}",
        "--project",
        "${workspaceFolder}"
      ],
      "command": "{{ .chezmoi.homeDir }}/.local/share/latex-workflow/.venv/bin/python",
      "label": "Figure: export PDF + LaTeX",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MPLCONFIGDIR": "{{ .chezmoi.homeDir }}/.local/share/latex-workflow/cache/matplotlib"
        }
      },
      "problemMatcher": [],
      "type": "process"
    },
    {
      "args": [
        "{{ .chezmoi.homeDir }}/.local/share/latex-workflow/tools/plot_example.py",
        "--project",
        "${workspaceFolder}"
      ],
      "command": "{{ .chezmoi.homeDir }}/.local/share/latex-workflow/.venv/bin/python",
      "label": "Plot: generate normal distribution",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MPLCONFIGDIR": "{{ .chezmoi.homeDir }}/.local/share/latex-workflow/cache/matplotlib"
        }
      },
      "problemMatcher": [],
      "type": "process"
    }
  ],
  "version": "2.0.0"
}
