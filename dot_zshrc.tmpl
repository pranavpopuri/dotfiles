{{ template "shellrc-common" . }}
command -v fzf >/dev/null && source <(fzf --zsh)

[[ -o interactive ]] && [ -f ~/.config/dateprogress.zsh ] && source ~/.config/dateprogress.zsh

command -v zoxide >/dev/null && eval "$(zoxide init zsh --cmd cd)"

# Prompt: directory-only locally; user@host reappears over SSH (starship defaults)
command -v starship >/dev/null && eval "$(starship init zsh)"

# Only activate machine-specific bits where they actually exist.
[ -d "$HOME/Miniforge3/bin" ] && export PATH="$HOME/Miniforge3/bin:$PATH"

# audiobook-pipeline: point at ebook2audiobook install
[ -d "$HOME/Documents/GitHub/ebook2audiobook" ] && export EBOOK2AUDIOBOOK_HOME="$HOME/Documents/GitHub/ebook2audiobook"
